# Avatar (Anam) - render-only judge
ANAM_API_KEY=
# Optional overrides (defaults: a formal grey-haired judge avatar and British voice)
# ANAM_AVATAR_ID=
# ANAM_VOICE_ID=
# ANAM_AVATAR_MODEL=cara-4

# Speech (Gnani): speech-to-text (Prisma) and counsel voice (Timbre)
GNANI_API_KEY=

# Question logic: any OpenAI-compatible chat endpoint. Examples:
#   Groq:   https://api.groq.com/openai/v1   model: openai/gpt-oss-120b
#   OpenAI: https://api.openai.com/v1         model: gpt-4o-mini
# Leave LLM_API_KEY empty to use the scripted judge.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# Optional second provider, used automatically if the first fails or is rate limited
# LLM2_BASE_URL=
# LLM2_API_KEY=
# LLM2_MODEL=

# Public URL (for link previews)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
